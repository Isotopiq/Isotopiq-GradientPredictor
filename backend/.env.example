# Backend .env example (root .env is used by docker-compose; this is for local runs)
# Uses unique port 18700 to avoid conflicts with other services
DATABASE_URL=postgresql+asyncpg://lcms:changeme@localhost:18732/lcms
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:18780,http://localhost:18717
MODEL_STORAGE_PATH=./models
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# SMTP for password reset emails (leave empty to disable email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@isotopiq.app
SMTP_FROM_NAME=IsotopiQ
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:18780
