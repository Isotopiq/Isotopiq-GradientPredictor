# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL (internal to compose network on 5432; expose on host via 18732 if needed)
POSTGRES_USER=lcms
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lcms
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lcms:changeme@db:5432/lcms

# Backend (unique port 18700 to avoid conflicts)
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:18780,http://localhost:18717
MODEL_STORAGE_PATH=/app/models
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# Default admin user (seeded on first startup — CHANGE THE PASSWORD!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin-2024!

# Frontend (unique port 18780 for prod nginx, 18717 for dev Vite)
VITE_API_BASE_URL=/api/v1
